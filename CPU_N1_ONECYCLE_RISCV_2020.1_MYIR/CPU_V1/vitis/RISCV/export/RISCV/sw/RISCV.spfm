<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="RISCV"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
RISCV
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="RISCV">
        <sdx:configuration sdx:name="RISCV"
                           sdx:displayName="RISCV"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>RISCV</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="RISCV/boot/RISCV.bif"
                            sdx:readme="RISCV/boot/generic.readme"
                            sdx:qemuArguments="RISCV/qemu/pmu_args.txt:RISCV/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="RISCV/boot/RISCV.bif"
                            sdx:readme="RISCV/boot/generic.readme"
                            sdx:qemuArguments="RISCV/standalone_domain/qemu/pmu_args.txt:RISCV/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone_domain"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="RISCV/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="RISCV/standalone_domain/bspinclude/include"
                        sdx:bspConfig="RISCV/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
